APP_NAME="Trilha+"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# In production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production over HTTPS: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true
# When behind a reverse proxy, set TRUSTED_PROXIES to explicit proxy IPs/CIDRs; never use *.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Configure trusted local PDF parser wrapper + ClamAV executable before accepting PDFs.
PDF_VALIDATOR_BINARY=
ANTIVIRUS_BINARY=
QUEUE_CONNECTION=database

CACHE_STORE=database
# Use database for one application instance; use shared Redis when running multiple instances.
RATE_LIMITER_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Desenvolvimento: MAIL_MAILER=log grava os e-mails em storage/logs. Em produção use smtp,
# senão a recuperação de senha não chega ao usuário. Exemplo Hostinger (caixa criada no hPanel):
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.hostinger.com  MAIL_PORT=465  MAIL_SCHEME=smtps
#   MAIL_USERNAME=no-reply@seudominio.com.br  MAIL_PASSWORD=...  MAIL_FROM_ADDRESS=no-reply@seudominio.com.br
# Teste com: php artisan mail:test seu@email.com   |   Confira tudo com: php artisan app:preflight
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backup diário (php artisan backup:run, agendado às BACKUP_TIME; exige o cron do schedule:run).
# BACKUP_COPY_DISK é uma cópia FORA do servidor (disco S3/SFTP definido em config/filesystems.php).
BACKUP_ENABLED=true
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=3
BACKUP_COPY_DISK=
# Criptografia do backup: gere com php artisan backup:key e guarde a chave FORA do servidor.
BACKUP_ENCRYPTION_KEY=
BACKUP_NOTIFY_EMAIL=
